---
import "../styles/global.css";

interface Props {
    title: string;
    eyebrow: string;
    heading: string;
    lede: string;
}

const { title, eyebrow, heading, lede } = Astro.props;

// Fetch the anonymous public-summary endpoint at render time.
// Falls back to nulls on any network/parse failure so a broken API
// never prevents the login page from loading.
interface PublicSummary {
    activeWarehouses: number;
    activeSkus: number;
    stockLocations: number;
}

let publicSummary: PublicSummary | null = null;
try {
    const apiBase =
        import.meta.env.INTERNAL_API_BASE_URL ??
        import.meta.env.PUBLIC_API_BASE_URL ??
        "";
    const res = await fetch(`${apiBase}/stats/public-summary`);
    console.log("status", res.status);
    publicSummary = await res.json();
} catch (e) {}

const fmt = (n: number | undefined) =>
    n !== undefined ? n.toLocaleString("en") : "—";
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>{title} | invenTU</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <script is:inline>
            (function () {
                try {
                    const root = document.documentElement;
                    const storedTheme = localStorage.getItem("theme");
                    const dark =
                        storedTheme === "dark" ||
                        (!storedTheme &&
                            window.matchMedia("(prefers-color-scheme: dark)")
                                .matches);
                    root.classList.toggle("dark", dark);
                    const density =
                        localStorage.getItem("density") === "compact"
                            ? "compact"
                            : "comfortable";
                    root.dataset.density = density;
                } catch (_) {}
            })();
        </script>
    </head>
    <body class="h-full" style="background: var(--color-bg);">
        <div class="auth">
            <div class="auth-art">
                <div class="row" style="gap: 10px;">
                    <span class="brand-mark"></span>
                    <span class="brand-name" style="font-size: 16px;"
                        >InvenTU</span
                    >
                </div>

                <div
                    style="margin-top: auto; display: flex; flex-direction: column; gap: 14px;"
                >
                    <div class="micro" style="color: var(--color-accent);">
                        OPS · CONSOLE · v0.1
                    </div>
                    <h2
                        style="font-size: 32px; line-height: 1.1; margin: 0; font-weight: 600; letter-spacing: -0.01em; max-width: 360px; color: var(--color-shell-ink);"
                    >
                        Inventory you can trust at the bin level.
                    </h2>
                    <p
                        style="color: var(--color-shell-ink-mute); margin: 0; font-family: var(--font-mono); font-size: 12px; max-width: 360px; line-height: 1.6;"
                    >
                        Real-time stock, scan-driven receiving, and
                        operator-grade controls across every facility on your
                        network.
                    </p>
                </div>

                <div
                    style="margin-top: 32px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; font-family: var(--font-mono); font-size: 11px;"
                >
                    <div
                        style="border-top: 2px solid var(--color-accent); padding-top: 8px;"
                    >
                        <div
                            style="color: var(--color-shell-ink-mute); letter-spacing: 0.1em;"
                        >
                            FACILITIES
                        </div>
                        <div
                            style="font-size: 18px; font-weight: 600; color: var(--color-shell-ink); margin-top: 2px;"
                        >
                            {fmt(publicSummary?.activeWarehouses)}
                        </div>
                    </div>
                    <div
                        style="border-top: 2px solid var(--color-accent); padding-top: 8px;"
                    >
                        <div
                            style="color: var(--color-shell-ink-mute); letter-spacing: 0.1em;"
                        >
                            ACTIVE SKUs
                        </div>
                        <div
                            style="font-size: 18px; font-weight: 600; color: var(--color-shell-ink); margin-top: 2px;"
                        >
                            {fmt(publicSummary?.activeSkus)}
                        </div>
                    </div>
                    <div
                        style="border-top: 2px solid var(--color-accent); padding-top: 8px;"
                    >
                        <div
                            style="color: var(--color-shell-ink-mute); letter-spacing: 0.1em;"
                        >
                            LOCATIONS
                        </div>
                        <div
                            style="font-size: 18px; font-weight: 600; color: var(--color-shell-ink); margin-top: 2px;"
                        >
                            {fmt(publicSummary?.stockLocations)}
                        </div>
                    </div>
                </div>

                <svg
                    style="position: absolute; right: -40px; top: 80px; opacity: 0.18; width: 320px; height: 320px;"
                    viewBox="0 0 200 200"
                    fill="none"
                    stroke="var(--color-accent)"
                    stroke-width="0.6"
                >
                    <rect x="20" y="20" width="160" height="160"></rect>
                    <rect x="24" y="24" width="152" height="152"></rect>
                    <rect x="28" y="28" width="144" height="144"></rect>
                    <rect x="32" y="32" width="136" height="136"></rect>
                    <rect x="36" y="36" width="128" height="128"></rect>
                    <rect x="40" y="40" width="120" height="120"></rect>
                    <rect x="44" y="44" width="112" height="112"></rect>
                    <rect x="48" y="48" width="104" height="104"></rect>
                    <rect x="52" y="52" width="96" height="96"></rect>
                    <rect x="56" y="56" width="88" height="88"></rect>
                    <rect x="60" y="60" width="80" height="80"></rect>
                    <rect x="64" y="64" width="72" height="72"></rect>
                    <rect x="68" y="68" width="64" height="64"></rect>
                    <rect x="72" y="72" width="56" height="56"></rect>
                    <line x1="0" y1="100" x2="200" y2="100" stroke-width="1.2"
                    ></line>
                    <line x1="100" y1="0" x2="100" y2="200" stroke-width="1.2"
                    ></line>
                </svg>
            </div>

            <div class="auth-form">
                <div style="max-width: 380px; width: 100%;">
                    <div
                        class="micro"
                        style="margin-bottom: 16px; color: var(--color-accent);"
                    >
                        {eyebrow}
                    </div>
                    <h1>{heading}</h1>
                    <p class="lede">{lede}</p>
                    <slot />
                </div>
            </div>
        </div>
    </body>
</html>
