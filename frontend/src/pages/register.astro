---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="h-full bg-surface-alt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Register | invenTU</title>
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="flex h-full items-center justify-center">
    <div class="w-full max-w-md rounded-lg bg-surface p-8 shadow-card">
      <h1 class="mb-6 text-center text-2xl font-bold text-text-primary">invenTU</h1>
      <p class="text-center text-text-muted">Register page — under construction.</p>
    </div>
  </body>
</html>
