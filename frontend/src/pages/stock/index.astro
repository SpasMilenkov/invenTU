---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Stock Operations">
  <div class="mx-auto max-w-5xl">
    <header class="mb-6">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-text-muted">Inventory</p>
      <h1 class="mt-1 text-2xl font-semibold text-text-primary">Stock Operations</h1>
      <p class="mt-1 text-sm text-text-muted">Choose an operation below.</p>
    </header>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href="/stock/adjustments"
        class="rounded-card border border-surface-border bg-surface p-5 shadow-card transition-shadow hover:shadow-md"
      >
        <h2 class="font-semibold text-text-primary">Stock Adjustments</h2>
        <p class="mt-1 text-sm text-text-muted">
          Submit count corrections. Large discrepancies are sent for manager approval.
        </p>
      </a>
    </div>
  </div>
</Layout>
