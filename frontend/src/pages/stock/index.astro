---
import Layout from '../../layouts/Layout.astro';
import StockSubNav from '../../components/stock/shared/StockSubNav';

const ops = [
  {
    id: 'receive',
    href: '/stock/receive',
    label: 'Receive',
    desc: 'Inbound shipment from supplier or transfer.',
    color: 'var(--color-ok)',
    verb: '+ in',
    iconPath:
      'M3 13 H8 L9 16 H15 L16 13 H21 M3 13 V20 H21 V13 L17 4 H7 Z',
  },
  {
    id: 'issue',
    href: '/stock/issue',
    label: 'Issue / Pick',
    desc: 'Outbound order fulfilment from a bin.',
    color: 'var(--color-crit)',
    verb: '− out',
    iconPath: 'M5 12 H19 M14 7 L19 12 L14 17',
  },
  {
    id: 'transfer',
    href: '/stock/transfer',
    label: 'Transfer',
    desc: 'Move stock between bins or warehouses.',
    color: 'var(--color-info)',
    verb: '↔ move',
    iconPath:
      'M12 3 L21 8 L12 13 L3 8 Z M3 12 L12 17 L21 12 M3 16 L12 21 L21 16',
  },
  {
    id: 'adjustments',
    href: '/stock/adjustments',
    label: 'Adjust',
    desc: 'Cycle-count correction or shrinkage.',
    color: 'var(--color-warn)',
    verb: '± fix',
    iconPath:
      'M12 3 V6 M12 18 V21 M3 12 H6 M18 12 H21 M5.5 5.5 L7.5 7.5 M16.5 16.5 L18.5 18.5 M5.5 18.5 L7.5 16.5 M16.5 7.5 L18.5 5.5',
  },
];
---

<Layout title="Stock Operations" crumb="Stock Operations">
  <div class="page-head">
    <div>
      <div class="page-sub">OPERATE / STOCK</div>
      <h1 class="page-title">Stock Operations</h1>
      <p class="mt-1 text-[12.5px]" style="color: var(--color-ink-3);">
        Pick a guided flow. Each operation walks you through the steps that match its purpose.
      </p>
    </div>
  </div>

  <StockSubNav active="hub" client:load />

  <div class="op-launcher">
    {ops.map((o) => (
      <a href={o.href} class="op-card">
        <div class="op-card-head">
          <span class="op-card-pip" style={`background:${o.color}`}></span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="square"
            stroke-linejoin="miter"
          >
            <path d={o.iconPath} />
          </svg>
          <span class="op-card-verb">{o.verb}</span>
        </div>
        <div class="op-card-label">{o.label}</div>
        <div class="op-card-desc">{o.desc}</div>
        <div class="op-card-cta">
          <span>OPEN GUIDED FLOW</span>
          <span>›</span>
        </div>
      </a>
    ))}
  </div>
</Layout>
