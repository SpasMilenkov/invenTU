---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Stock Operations" crumb="Stock Operations">
  <div class="page-head">
    <div>
      <div class="page-sub">OPERATE / STOCK</div>
      <h1 class="page-title">Stock Operations</h1>
      <p class="mt-1 text-[12.5px]" style="color: var(--color-ink-3);">Choose an operation below.</p>
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <a href="/stock/receive" class="panel" style="text-decoration: none; transition: border-color .15s;">
      <div class="panel-head">
        <span class="panel-title">RECEIVE</span>
        <span class="micro" style="color: var(--color-ok);">IN</span>
      </div>
      <div class="panel-body">
        <h2 class="text-[14px] font-semibold" style="color: var(--color-ink); margin: 0 0 6px;">Receive stock</h2>
        <p class="text-[12px]" style="color: var(--color-ink-3);">
          Record inbound goods from a purchase order or direct delivery.
        </p>
      </div>
    </a>
    <a href="/stock/issue" class="panel" style="text-decoration: none;">
      <div class="panel-head">
        <span class="panel-title">ISSUE</span>
        <span class="micro" style="color: var(--color-crit);">OUT</span>
      </div>
      <div class="panel-body">
        <h2 class="text-[14px] font-semibold" style="color: var(--color-ink); margin: 0 0 6px;">Issue / pick stock</h2>
        <p class="text-[12px]" style="color: var(--color-ink-3);">
          Remove stock from a location for an order or other outbound use.
        </p>
      </div>
    </a>
    <a href="/stock/transfer" class="panel" style="text-decoration: none;">
      <div class="panel-head">
        <span class="panel-title">TRANSFER</span>
        <span class="micro" style="color: var(--color-info);">XFER</span>
      </div>
      <div class="panel-body">
        <h2 class="text-[14px] font-semibold" style="color: var(--color-ink); margin: 0 0 6px;">Transfer stock</h2>
        <p class="text-[12px]" style="color: var(--color-ink-3);">
          Move stock between locations or warehouses within the system.
        </p>
      </div>
    </a>
    <a href="/stock/adjustments" class="panel" style="text-decoration: none;">
      <div class="panel-head">
        <span class="panel-title">ADJUST</span>
        <span class="micro" style="color: var(--color-warn);">ADJ</span>
      </div>
      <div class="panel-body">
        <h2 class="text-[14px] font-semibold" style="color: var(--color-ink); margin: 0 0 6px;">Stock adjustments</h2>
        <p class="text-[12px]" style="color: var(--color-ink-3);">
          Submit count corrections. Large discrepancies are sent for manager approval.
        </p>
      </div>
    </a>
  </div>
</Layout>
